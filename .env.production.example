# =========================================================================
# Producao (Docker) — copie para .env na raiz do servidor e preencha.
#   cp .env.production.example .env
# NUNCA commite o .env. Use as chaves de PRODUCAO do Clerk (pk_live_/sk_live_).
# =========================================================================

# ---- Clerk (autenticacao) ----
# publishable: embutida no build (build arg) E lida no runtime.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# secret: SOMENTE runtime (segredo, nunca vai para o bundle/imagem).
CLERK_SECRET_KEY=

# Rotas do Clerk (login/cadastro sao a propria pagina "/").
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ---- Supabase (banco) ----
# Embutidas no build E lidas no runtime (o painel do gestor le no servidor).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# ---- Webhook externo (referencia; disparo real e no painel do Supabase) ----
WEBHOOK_URL=https://seu-destino.exemplo.com/webhook
