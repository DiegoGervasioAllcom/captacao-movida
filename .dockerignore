# Mantem o contexto de build pequeno e evita vazar segredos/artefatos.
node_modules
.next
out
build
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# segredos e ambiente local (NUNCA entram na imagem)
.env
.env.*
!.env.example
!.env.production.example

# git / editor / SO
.git
.gitignore
.vscode
.idea
.DS_Store
*.pem

# infra / docs (nao precisam no build)
Dockerfile
docker-compose.yml
.dockerignore
.claude
tsconfig.tsbuildinfo
*.md

# job standalone, imagem Docker propria dele (vianuvem-import-job) - o app
# nao importa nada daqui. Faltava isso: todo build do app copiava a pasta
# vianuvem-import/debug/ inteira (prints de falha acumulados, nao
# rotacionados - ver vianuvem-import/README.md) pro contexto de build,
# desperdicando espaco em disco de verdade (foi a causa de um "no space
# left on device" real em producao, 23/09/2026).
vianuvem-import
