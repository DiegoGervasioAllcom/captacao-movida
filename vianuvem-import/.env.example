# =========================================================================
# vianuvem-import - variaveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env (ja esta no .gitignore).
# =========================================================================

# Login do ViaNuvem/Unico Auto (https://app.vianuvem.com.br/auto/login).
# Trate como credencial de producao: sem isso no repositorio, sem printar
# em log, com o mesmo cuidado de qualquer senha do CLAUDE.md regra 5.
#
# ATENCAO: se a senha tiver "#", "espacos" ou aspas, coloque o valor inteiro
# entre aspas duplas (ex.: VIANUVEM_SENHA="minha#senha 123") - sem aspas, o
# dotenv trata tudo depois do "#" como comentario e corta a senha em
# silencio (foi exatamente isso que quebrou o login aqui - sem erro
# nenhum, so autenticava com uma senha errada/incompleta).
VIANUVEM_USUARIO=
VIANUVEM_SENHA=

# Supabase - projeto Captacao Movida. Aqui e a service_role key (bypassa
# RLS de proposito, porque este job roda como um processo de confianca do
# servidor, nao como um vendedor logado). NUNCA use essa chave no frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Opcional - so pra depurar localmente. Com "false", abre o navegador
# visivel (nao headless) e deixa as acoes mais lentas/visiveis. Em
# producao (cron/servidor sem tela) NAO defina essa variavel.
VIANUVEM_HEADLESS=false
