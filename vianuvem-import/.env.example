# =========================================================================
# vianuvem-import - variaveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env (ja esta no .gitignore).
# =========================================================================

# Login do ViaNuvem/Unico Auto (https://app.vianuvem.com.br/auto/login).
# Trate como credencial de producao: sem isso no repositorio, sem printar
# em log, com o mesmo cuidado de qualquer senha do CLAUDE.md regra 5.
VIANUVEM_USUARIO=
VIANUVEM_SENHA=

# Supabase - projeto Captacao Movida. Aqui e a service_role key (bypassa
# RLS de proposito, porque este job roda como um processo de confianca do
# servidor, nao como um vendedor logado). NUNCA use essa chave no frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
