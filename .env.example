# =========================================================================
# Captacao Movida - variaveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite o .env.local nem coloque segredos no codigo.
# =========================================================================

# ---- Clerk (autenticacao) ----
# Painel: https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Rotas do Clerk - a tela de login/cadastro e a propria pagina principal ("/")
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ---- Supabase (banco de dados) ----
# Painel: https://supabase.com/dashboard -> Project Settings > Data API
# Use apenas a URL base (ex.: https://xxxx.supabase.co), sem /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable key" (antiga anon/public key). Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# ---- Webhook externo ----
# A URL para onde cada nova captacao deve ser encaminhada.
# Usada pelo Database Webhook do Supabase (NUNCA fixe a URL no codigo).
# Esta variavel fica aqui apenas como referencia/documentacao; o disparo
# real e configurado no painel do Supabase (veja o README).
WEBHOOK_URL=https://seu-destino.exemplo.com/webhook

# ---- Relatorio de seguros (endpoint doGet do Apps Script) ----
# URL do MESMO Web App do captacoes-to-google-sheets.gs (termina em /exec) e
# o segredo de LEITURA (SEGUROS_READ_SECRET no Apps Script - separado do
# WEBHOOK_SECRET usado pela escrita). So servidor (nao leva NEXT_PUBLIC_).
SEGUROS_SHEETS_URL=
SEGUROS_READ_SECRET=
